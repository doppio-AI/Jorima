generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model usuario {
  usuario_id       Int        @id @default(autoincrement())
  tipo_usuario     Int
  correo           String     @unique @db.VarChar(150)
  nombre           String     @db.VarChar(100)
  apellido_paterno String     @db.VarChar(100)
  apellido_materno String?    @db.VarChar(100)
  contrasena       String
  edificio_id      Int
  turno            String?    @db.VarChar(50)
  fecha_registro   DateTime?  @default(now()) @db.Timestamp(6)
  encuesta         encuesta[]
  edificio         edificio   @relation(fields: [edificio_id], references: [edificio_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_edificio")

  @@index([edificio_id], map: "idx_usuario_edificio")
}

model encuesta {
  encuesta_id    Int         @id @default(autoincrement())
  titulo         String      @db.VarChar(200)
  descripcion    String?
  fecha_creacion DateTime?   @default(now()) @db.Timestamp(6)
  edificio_id    Int
  creador_id     Int
  usuario        usuario     @relation(fields: [creador_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_creador_encuesta")
  edificio       edificio    @relation(fields: [edificio_id], references: [edificio_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_encuesta_edificio")
  respuesta      respuesta[]

  @@index([edificio_id], map: "idx_encuesta_edificio")
}

model edificio {
  edificio_id Int        @id @default(autoincrement())
  nombre      String     @db.VarChar(100)
  descripcion String?
  encuesta    encuesta[]
  usuario     usuario[]
}

model respuesta {
  respuesta_id Int       @id @default(autoincrement())
  encuesta_id  Int
  respuesta    Json
  fecha        DateTime? @default(now()) @db.Timestamp(6)
  encuesta     encuesta  @relation(fields: [encuesta_id], references: [encuesta_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_respuesta_encuesta")

  @@index([encuesta_id], map: "idx_respuesta_encuesta")
}
