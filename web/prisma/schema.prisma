generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model usuario {
  usuario_id                                   Int                   @id @default(autoincrement())
  tipo_usuario                                 Int
  correo                                       String                @unique @db.VarChar(150)
  nombre                                       String                @db.VarChar(100)
  apellido_paterno                             String                @db.VarChar(100)
  apellido_materno                             String?               @db.VarChar(100)
  contrasena                                   String
  edificio_id                                  Int
  turno                                        String?               @db.VarChar(50)
  fecha_registro                               DateTime?             @default(now()) @db.Timestamp(6)
  conversacion                                 conversacion[]
  codigo_verificacion                          codigo_verificacion[]
  reporte_reporte_usuario_personal_idTousuario reporte[]             @relation("reporte_usuario_personal_idTousuario")
  reporte_reporte_usuario_rh_idTousuario       reporte[]             @relation("reporte_usuario_rh_idTousuario")
  edificio                                     edificio              @relation(fields: [edificio_id], references: [edificio_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_usuario_edificio")

  @@index([edificio_id], map: "idx_usuario_edificio")
}

model edificio {
  edificio_id       Int                 @id @default(autoincrement())
  nombre            String              @db.VarChar(100)
  descripcion       String?
  respuesta         respuesta[]
  riesgo_prediccion riesgo_prediccion[]
  usuario           usuario[]
}

model respuesta {
  respuesta_id Int       @id @default(autoincrement())
  edificio_id  Int
  respuestas   Json
  fecha        DateTime? @default(now()) @db.Timestamp(6)
  edificio     edificio  @relation(fields: [edificio_id], references: [edificio_id], onDelete: NoAction, onUpdate: NoAction)
}

model conversacion {
  conversacion_id Int       @id @default(autoincrement())
  usuario_id      Int
  titulo          String?   @db.VarChar(200)
  fecha_creacion  DateTime? @default(now()) @db.Timestamp(6)
  activa          Boolean   @default(true)
  usuario         usuario   @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)
  mensaje         mensaje[]

  @@index([usuario_id], map: "idx_conversacion_usuario")
}

model mensaje {
  mensaje_id      Int          @id @default(autoincrement())
  conversacion_id Int
  role            String       @db.VarChar(20)
  texto           String
  fecha           DateTime?    @default(now()) @db.Timestamp(6)
  conversacion    conversacion @relation(fields: [conversacion_id], references: [conversacion_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversacion_id], map: "idx_mensaje_conversacion")
}

model codigo_verificacion {
  codigo_id        Int      @id @default(autoincrement())
  usuario_id       Int
  codigo           String   @db.VarChar(6)
  fecha_creacion   DateTime @default(now()) @db.Timestamp(6)
  fecha_expiracion DateTime @db.Timestamp(6)
  usado            Boolean  @default(false)
  usuario          usuario  @relation(fields: [usuario_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id], map: "idx_codigo_usuario")
  @@index([codigo], map: "idx_codigo_valor")
}

model reporte {
  reporte_id                                   Int       @id @default(autoincrement())
  usuario_rh_id                                Int
  usuario_personal_id                          Int
  nivel_urgencia                               String    @db.VarChar(50)
  tipo_seguimiento                             String    @db.VarChar(100)
  estado                                       String?   @default("Pendiente") @db.VarChar(50)
  notas                                        String?
  nombre_archivo                               String    @db.VarChar(255)
  mime_type                                    String?   @db.VarChar(150)
  tamano_bytes                                 Int?
  archivo_binario                              Bytes?
  ruta                                         String    @db.VarChar(255)
  hash                                         String    @db.VarChar(64)
  fecha_creacion                               DateTime? @default(now()) @db.Timestamp(6)
  usuario_reporte_usuario_personal_idTousuario usuario   @relation("reporte_usuario_personal_idTousuario", fields: [usuario_personal_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reporte_personal")
  usuario_reporte_usuario_rh_idTousuario       usuario   @relation("reporte_usuario_rh_idTousuario", fields: [usuario_rh_id], references: [usuario_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reporte_rh")
}

model riesgo_prediccion {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  edificio_id           Int
  fecha                 DateTime? @default(now()) @db.Timestamp(6)
  respuestas            Json
  riesgo_base           Float
  riesgo_proyeccion_30d Float
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  edificio              edificio  @relation(fields: [edificio_id], references: [edificio_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_riesgo_edificio")
}
